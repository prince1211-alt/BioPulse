NODE_ENV=development
PORT=4000
DATABASE_URL=mongodb://127.0.0.1:27017/biopulse?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Set to the number of trusted reverse proxy hops (e.g. 1 behind one hosting proxy).
TRUST_PROXY=0
# The API runs workers by default. Set false when running npm run worker separately.
RUN_WORKERS=true

# Report storage and AI analysis
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
USDA_API_KEY=

# Optional email delivery (disabled when credentials are absent)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Firebase Admin (use this group OR GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
